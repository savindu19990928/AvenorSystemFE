{
  "name": "avenor-system-fe",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on tcp:5173 && electron . --dev\"",
    "electron:build": "npm run build && electron-builder",
    "electron:build:mac": "npm run build && electron-builder --mac",
    "electron:build:mac:arm64": "npm run build && electron-builder --mac --arm64",
    "electron:build:mac:x64": "npm run build && electron-builder --mac --x64",
    "electron:build:mac:universal": "npm run build && electron-builder --mac --universal"
  },
  "dependencies": {
    "@emotion/react": "^11.13.3",
    "date-fns": "^4.0.0",
    "framer-motion": "^11.5.4",
    "html2canvas": "latest",
    "jspdf": "^4.2.1",
    "lucide-react": "0.522.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@types/node": "^20.11.18",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "latest",
    "autoprefixer": "latest",
    "concurrently": "^10.0.5",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^8.50.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "postcss": "latest",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.5.4",
    "vite": "^8.3.1",
    "wait-on": "^9.5.1"
  }
}
